  <string name="audio_adv_output_now">Output now: %1$s</string>
  <string name="audio_adv_reach_adb">ADB</string>
  <string name="audio_adv_reach_adb_desc">Also equalizes other apps (Spotify, YouTube, games), like Poweramp Equalizer. Needs the DUMP permission, granted once from a computer.</string>
  <string name="audio_adv_reach_adb_idle">On. No other app is playing now.</string>
  <string name="audio_adv_reach_app">No root</string>
  <string name="audio_adv_reach_app_desc">Equalizes the songs and sounds T.A.R.K.A.S. plays. Needs nothing.</string>
  <plurals name="audio_adv_reach_conflict">
    <item quantity="one">In %1$d app, another equalizer app has priority and this curve is not applied. Turn the other one off to use T.A.R.K.A.S.\'s.</item>
    <item quantity="other">In %1$d apps, another equalizer app has priority and this curve is not applied. Turn the other one off to use T.A.R.K.A.S.\'s.</item>
  </plurals>
  <string name="audio_adv_reach_no_root">This device has no root (the su command does not exist). Use ADB mode.</string>
  <string name="audio_adv_reach_now">Equalizing now: %1$s.</string>
  <string name="audio_adv_reach_now_global">Equalizing now: %1$s, and the general output.</string>
  <string name="audio_adv_reach_root">Root</string>
  <string name="audio_adv_reach_root_denied">Root has not been granted yet. Allow T.A.R.K.A.S. in Magisk (or in your root manager) and choose Root again.</string>
  <string name="audio_adv_reach_root_desc">Everything in ADB mode without a computer: the app grants the permission by itself through root and uses the general output when the device allows it, to also reach sounds with no session of their own.</string>
  <string name="audio_adv_reach_root_idle">On with root. No other app is playing now.</string>
  <string name="audio_adv_reach_root_idle_global">On with root, including the general output. No other app is playing now.</string>
