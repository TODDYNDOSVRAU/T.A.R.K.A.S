<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Assistant tab. Default language: English. Portuguese is in values-pt/strings_assistant.xml. -->

    <!-- Header status -->
    <string name="assistant_status_online">Local commands and online AI (Gemini).</string>
    <string name="assistant_status_local">Local commands. No online AI.</string>
    <string name="assistant_enable_action">Details</string>
    <string name="assistant_enable_hide">Hide</string>
    <string name="assistant_enable_body">Online replies (Gemini) are not available in this version of the app. Local commands, such as changing track or adjusting the sound, work normally.</string>

    <!-- Empty state -->
    <string name="assistant_empty_title">How can I help?</string>
    <string name="assistant_empty_body">Ask to change track, adjust the equalizer or set a timer. Tap the microphone to speak.</string>

    <!-- Suggestions (the command sent is fixed; only the label is translated) -->
    <string name="assistant_suggestion_next">Next track</string>
    <string name="assistant_suggestion_shuffle">Shuffle</string>
    <string name="assistant_suggestion_repeat">Repeat</string>
    <string name="assistant_suggestion_favorite">Favorite</string>
    <string name="assistant_suggestion_diagnostics">Audio diagnostics</string>
    <string name="assistant_suggestion_eq_flat">Flat equalizer</string>
    <string name="assistant_suggestion_timer">15 min timer</string>
    <string name="assistant_suggestion_help">Help</string>

    <!-- Who spoke, for screen readers -->
    <string name="assistant_sender_user">You</string>
    <string name="assistant_sender_assistant">Assistant</string>
    <string name="assistant_sender_tool">Action</string>
    <string name="assistant_sender_system">Notice</string>
    <string name="assistant_message_spoken">%1$s: %2$s</string>

    <!-- States -->
    <string name="assistant_listening">Listening</string>
    <string name="assistant_thinking">Thinking</string>
    <string name="assistant_thinking_visible">Thinking…</string>

    <!-- Voice input -->
    <string name="assistant_voice_prompt">Ask for an analysis, change track or adjust the sound</string>
    <string name="assistant_voice_unavailable">This device has no speech recognition. Type the request below.</string>
    <string name="assistant_voice_failed">Could not open speech recognition. Type the request below.</string>

    <!-- Controls -->
    <string name="assistant_mic_idle">Speak to the assistant</string>
    <string name="assistant_send">Send</string>
    <string name="assistant_composer_description">Message to the assistant</string>
    <string name="assistant_composer_placeholder">Ask for something or type \"help\"</string>
    <string name="assistant_timer_line">%1$s: %2$s</string>
    <string name="assistant_timer_cancel">Cancel timer %1$s</string>

    <!-- Greeting when the tab opens -->
    <string name="assistant_greeting">How can I help with your music or audio today?</string>

    <!-- Results of local player commands, shown in the conversation -->
    <string name="assistant_result_now_playing">Now playing %1$s</string>
    <string name="assistant_result_playing">Playing %1$s</string>
    <string name="assistant_result_paused">Paused</string>
    <string name="assistant_result_already_paused">Already paused</string>
    <string name="assistant_result_shuffle_on">Shuffle on</string>
    <string name="assistant_result_shuffle_off">Shuffle off</string>
    <string name="assistant_result_repeat_off">Repeat off</string>
    <string name="assistant_result_repeat_all">Repeating the whole list</string>
    <string name="assistant_result_repeat_one">Repeating one track</string>
    <string name="assistant_result_favorite_added">%1$s added to favorites</string>
    <string name="assistant_result_favorite_removed">%1$s removed from favorites</string>

    <!-- Online reply failures: what happened and what to do -->
    <string name="assistant_error_no_connection">No connection to the online service. Check your internet and try again.</string>
    <string name="assistant_error_key_refused">The online service refused this app\'s key, so online replies are off. Local commands still work.</string>
    <string name="assistant_error_quota">The online service has reached its usage limit for now. Wait a little, then try again.</string>
    <string name="assistant_error_cut_off">The reply was too long and was cut off, so it was not shown. Ask a shorter question and try again.</string>
    <string name="assistant_error_no_reply">The online service did not return a reply to this question. Try again.</string>
    <string name="assistant_error_server">The online service did not answer correctly. Try again in a moment.</string>
    <string name="assistant_retry">Try again</string>
