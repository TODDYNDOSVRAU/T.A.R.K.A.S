<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android's automatic backup keeps (API 30 and older, and the fallback below). It is a list of
  what to keep: anything not named here stays out. In: settings, loudness measured, the database
  (library, playlists, favourites, play statistics, player state). Out: diagnostics, waveforms and
  covers (recalculated), update state (describes this install, not the person).
-->
<full-backup-content>
    <include domain="sharedpref" path="tarkas_prefs.xml"/>
    <include domain="sharedpref" path="tarkas_loudness.xml"/>
    <include domain="database" path="."/>
</full-backup-content>
