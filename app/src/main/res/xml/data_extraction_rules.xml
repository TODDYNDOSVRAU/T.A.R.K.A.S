<?xml version="1.0" encoding="utf-8"?>
<!--
  Same list as backup_rules.xml, for Android 12 and newer: cloud backup and device-to-device transfer.
  Only what is named is kept. Whether the cloud backup should exist at all is a privacy decision of
  the owner; the terms do not mention it today.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="tarkas_prefs.xml"/>
        <include domain="sharedpref" path="tarkas_loudness.xml"/>
        <include domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="tarkas_prefs.xml"/>
        <include domain="sharedpref" path="tarkas_loudness.xml"/>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
